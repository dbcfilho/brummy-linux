# Pacotes que existem só dentro da ISO live. O build-iso.sh gera a lista de
# remoção do módulo packages do Calamares A PARTIR DESTE ARQUIVO: o que está
# aqui sai do sistema instalado depois do unpackfs. Fonte única, sem cópia.
archiso
mkinitcpio-archiso
arch-install-scripts
squashfs-tools
memtest86+
memtest86+-efi
edk2-shell
# boot BIOS da própria ISO
syslinux
# os hooks archiso_pxe_nbd e archiso_pxe_nfs do mkinitcpio.conf.d/archiso.conf
# precisam destes; sem eles o initramfs do live não gera
nbd
mkinitcpio-nfs-utils
# o hook archiso copia o squashfs para a RAM com ele (copytoram); sem ele, cp
pv
# instalador gráfico (vem do AUR — construído por builder/aur-repo.sh)
calamares
