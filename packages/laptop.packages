vulkan-intel
libva-utils

# --- energia / térmico (ThinkPad clássico) ---
tlp
tlp-rdw
powertop
thermald
thinkfan
acpi
acpid

# --- wifi/bluetooth laptop (iwl4965/6205 no T430) ---
iw
wireless_tools
