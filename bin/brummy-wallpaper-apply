#!/usr/bin/env bash
# brummy-wallpaper-apply — aplica o wallpaper atual em todos os monitores.
# Resolve ~/Pictures/Brummy/current.jpg (link) para o arquivo real, porque o
# hyprpaper decide o decodificador pela extensão do arquivo.
#
# hyprpaper >= 0.8 (reescrito em hyprtoolkit) mudou o IPC: `preload`, `unload`
# e `listloaded` não existem mais. O único comando de escrita é
# `hyprctl hyprpaper wallpaper <monitor>,<caminho>` e o de leitura é
# `listactive`. Este script detecta as duas gerações para não quebrar.
# Uso: brummy-wallpaper-apply [caminho-da-imagem]
set -uo pipefail

WDIR="$HOME/Pictures/Brummy"
IMG="${1:-$WDIR/current.jpg}"
IMG="$(readlink -f "$IMG" 2>/dev/null || echo "$IMG")"

if [[ ! -f "$IMG" ]]; then
  echo "[brummy] sem wallpaper em $WDIR (rode ./install.sh)" >&2
  exit 0
fi

# hyprpaper pode ainda estar subindo no login: espera o IPC responder.
# listactive só existe na versão nova; na antiga listloaded responde.
hp_alive() {
  hyprctl hyprpaper listactive &>/dev/null || hyprctl hyprpaper listloaded &>/dev/null
}
for _ in $(seq 1 20); do
  hp_alive && break
  sleep 0.25
done

# Nova geração: um comando por monitor (ou wildcard, monitor vazio).
if hyprctl hyprpaper listactive &>/dev/null; then
  monitors="$(hyprctl -j monitors 2>/dev/null | grep -oP '"name":\s*"\K[^"]+' || true)"
  if [[ -z "$monitors" ]]; then
    hyprctl hyprpaper wallpaper ",$IMG" &>/dev/null || true
  else
    while read -r m; do
      [[ -z "$m" ]] && continue
      hyprctl hyprpaper wallpaper "$m,$IMG" &>/dev/null || true
    done <<< "$monitors"
  fi
  echo "[brummy] wallpaper: $(basename "$IMG")"
  exit 0
fi

# Antiga geração (hyprpaper < 0.8): preload + wallpaper.
hyprctl hyprpaper unload all &>/dev/null || true
if ! hyprctl hyprpaper preload "$IMG" &>/dev/null; then
  echo "[brummy] hyprpaper não respondeu (ipc = on em hyprpaper.conf?)" >&2
  exit 0
fi

monitors="$(hyprctl -j monitors 2>/dev/null | grep -oP '"name":\s*"\K[^"]+' || true)"
if [[ -z "$monitors" ]]; then
  hyprctl hyprpaper wallpaper ",$IMG" &>/dev/null || true
else
  while read -r m; do
    [[ -z "$m" ]] && continue
    hyprctl hyprpaper wallpaper "$m,$IMG" &>/dev/null || true
  done <<< "$monitors"
fi
echo "[brummy] wallpaper: $(basename "$IMG")"
