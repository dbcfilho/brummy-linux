// Brummy Linux — fastfetch com a logo do Brummy no lugar da do Arch.
//
// Padrão: ASCII (funciona em qualquer terminal, inclusive TTY e SSH).
// Regenerar em outra largura:
//     python3 ~/.config/fastfetch/make-ascii-logo.py 68 0.42
//
// Quer a logo de verdade, em imagem? No kitty (terminal padrão do Brummy)
// troque o bloco "logo" por:
//     "logo": {
//       "type": "kitty-direct",
//       "source": "~/.local/share/brummy/logo.png",
//       "width": 34, "height": 17,
//       "padding": { "top": 1, "right": 2 }
//     }
// (o install.sh copia a logo para ~/.local/share/brummy/logo.png)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/brummy.txt",
    "color": { "1": "white" },
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "white" }
  },

  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",

    { "type": "custom", "format": "── sistema ─────────" },
    { "type": "custom", "key": "  OS", "format": "Brummy Linux v1.1" },
    { "type": "os", "key": "  Base" },
    { "type": "kernel", "key": "  Kernel" },
    { "type": "host", "key": "  Host" },
    { "type": "uptime", "key": "  Uptime" },
    { "type": "packages", "key": "  Pacotes" },
    { "type": "shell", "key": "  Shell" },

    { "type": "custom", "format": "── ambiente ────────" },
    { "type": "wm", "key": "  WM" },
    { "type": "display", "key": "  Tela" },
    { "type": "theme", "key": "  Tema" },
    { "type": "icons", "key": "  Ícones" },
    { "type": "cursor", "key": "  Cursor" },
    { "type": "terminal", "key": "  Terminal" },
    { "type": "terminalfont", "key": "  Fonte" },

    { "type": "custom", "format": "── máquina ─────────" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "gpu", "key": "  GPU" },
    { "type": "memory", "key": "  RAM" },
    { "type": "swap", "key": "  Swap" },
    { "type": "disk", "key": "  Disco" },
    { "type": "localip", "key": "  IP" },
    { "type": "locale", "key": "  Locale" },

    "break",
    "colors"
  ]
}
